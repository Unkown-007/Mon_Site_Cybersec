# UnknownX-077 — variables d'environnement (exemple)
# Copier en .env.local pour le dev. Sur Vercel : Settings → Environment Variables.

# --- Auth réelle (session signée côté serveur) ---
# AUTH_SECRET : secret de signature des sessions. OBLIGATOIRE en production.
#   Génère-en un avec :  openssl rand -base64 32   (ou node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
# Identifiants de l'admin (vérifiés côté serveur, jamais exposés au navigateur)
ADMIN_EMAIL=admin@unknownx.local
ADMIN_PASSWORD=change-moi

# --- API GitHub (optionnel) : relève le quota du panneau /api/github ---
# GITHUB_TOKEN=

# --- Supabase / DB — à activer plus tard (write-ups, contenu dynamique) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
